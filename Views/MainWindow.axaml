<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MDMX_MaskCreator.ViewModels"
        x:Class="MDMX_MaskCreator.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/appicon.ico"
        Title="MDMX-MaskCreator - V1.0.4"
        Width="1300" Height="720"
        MinWidth="900" MinHeight="500">

    <DockPanel>

        <!-- toolbar -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>

                </Grid.ColumnDefinitions>
                
                <StackPanel
                    Orientation="Horizontal" Spacing="8"
                    >
                    <Button Command="{Binding LoadFixturesCommand}"
                            Content="Load fixtures"
                            ToolTip.Tip="Load Fixtures CSV first"
                            />
                    <Button Command="{Binding LoadPatchCommand}"
                            ToolTip.Tip="Then the CSV patch"
                            Content="Load patch" />
                    <Separator Width="1" Margin="4,0" />
                    <Button Command="{Binding SavePresetCommand}"
                            Content="Save preset" />
                    <Button Command="{Binding LoadPresetCommand}"
                            Content="Load preset" />

                </StackPanel>
                
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding ExportMaskCommand}"
                            Content="Export mask PNG"
                            Classes="accent" />
                    <Button Command="{Binding OpenExportFolderCommand}"
                            Content="Open export folder" />
                    <Separator Width="1" Margin="4,0" />
                    <Button Command="{Binding OpenSettingsCommand}"
                            Content="Settings" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- status bar -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,5">
            <StackPanel
                Orientation="Horizontal"
                >
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <Separator Width="5" Margin="4,0" />
                <TextBlock Text="{Binding PresetText}" 
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
        </Border>

        <!-- main content -->
        <Grid ColumnDefinitions="300,1,*">

            <!-- sidebar -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <TextBlock Text="FIXTURE INSTANCES"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </Border>
                
                <!-- fixture name filter -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="8">
                    <TextBox Text="{Binding FixtureFilter}"
                             Watermark="Filter by fixture name..."
                             FontSize="12" />
                </Border>

                <!-- DMX range input -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="8">
                    <StackPanel Spacing="4">
                        <TextBox Text="{Binding DmxRangeInput}"
                                 Watermark="e.g. U1:C1-C50, U1:C1-U2:C23"
                                 FontSize="12"
                                 ToolTip.Tip="Create masks directly using the Universe and Channel Numbers"
                                 />
                        <TextBlock Text="{Binding DmxRangeError}"
                                   FontSize="11"
                                   Foreground="Red"
                                   IsVisible="{Binding DmxRangeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>
                

                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding FilteredUniverses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:UniverseGroupViewModel">

                                <!-- universe group -->
                                <StackPanel>
                                    <!-- universe header -->
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <!-- expand toggle — only on the label area -->
                                            <Button Grid.Column="0"
                                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="12,6"
                                                    Command="{Binding ToggleExpandedCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="11"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                    <TextBlock Text="{Binding FixtureCount, StringFormat='({0})'}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
                                                </StackPanel>
                                            </Button>

                                            <!-- All/None as siblings, not children -->
                                            <Button Grid.Column="1"
                                                    Content="All"
                                                    FontSize="11"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding SelectAllCommand}" />
                                            <Button Grid.Column="2"
                                                    Content="None"
                                                    FontSize="11"
                                                    Padding="6,2"
                                                    Margin="4,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DeselectAllCommand}" />
                                        </Grid>
                                    

                                    <!-- fixture rows -->
                                    <ItemsControl ItemsSource="{Binding FilteredFixtures}"
                                                  IsVisible="{Binding IsExpanded}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PatchedFixtureViewModel">
                                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                                        BorderThickness="0,0,0,0.5"
                                                        Padding="24,4,12,4">
                                                    <CheckBox IsChecked="{Binding IsSelected}"
                                                              HorizontalAlignment="Stretch">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="12" />
                                                            <TextBlock Text="{Binding Meta}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- divider -->
            <Rectangle Grid.Column="1"
                       Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />

            <!-- preview panel -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                          VerticalAlignment="Center">
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="MASK PREVIEW"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <Button Grid.Column="1"
                                VerticalAlignment="Center"
                                Content="{Binding TogglePreviewModeLabel}"
                                FontSize="11"
                                Padding="6,3"
                                Command="{Binding TogglePreviewModeCommand}" />
                        <Separator Grid.Column="2" Width="1" Margin="4,0" />
                        <TextBlock Grid.Column="3"
                                   VerticalAlignment="Center"
                                   Text="2560 × 208 px"
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
                    </Grid>
                </Border>

                <!-- main content area: preview + legend side by side -->
                <Grid ColumnDefinitions="*,Auto">

                    <!-- preview -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                            Padding="16">
                        <StackPanel Spacing="10" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <Grid>
                                    <Image Source="{Binding PreviewBitmap}"
                                           Stretch="Uniform"
                                           x:Name="PreviewImage" />
                                    <Grid x:Name="LabelGrid" /> <!-- no fixed height, overlays image -->
                                </Grid>
                                <Grid x:Name="TextLabelGrid" Height="0" /> <!-- separate grid for text labels -->
                            </StackPanel>
                            <TextBlock Text="{Binding MaskedSummary}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- legend sidebar -->
                    <Border Grid.Column="1"
                            IsVisible="{Binding ShowLegend}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                            BorderThickness="1,0,0,0"
                            Width="160"
                            Padding="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="LEGEND"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Margin="0,0,0,8"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding LegendItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LegendItem">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6"
                                                        Margin="0,3">
                                                <Border Width="14"
                                                        Height="14"
                                                        CornerRadius="2"
                                                        Background="{Binding Color,
                                                            Converter={StaticResource ColorToBrushConverter}}" />
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>