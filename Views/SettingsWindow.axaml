<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MDMX_MaskCreator.ViewModels"
        x:Class="MDMX_MaskCreator.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Title="Settings"
        Width="400" Height="320"
        CanResize="false"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Click="OnCancelClick" />
            <Button Content="Save"
                    Classes="accent"
                    Click="OnSaveClick" />
        </StackPanel>

        <StackPanel Spacing="16">

            <TextBlock Text="RENDER SETTINGS"
                       FontSize="11"
                       FontWeight="Medium"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

            <!-- grid width -->
            <StackPanel Spacing="6">
                <TextBlock Text="Grid width (px)" FontSize="13" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumericUpDown Value="{Binding GridWidth}"
                                   Minimum="1280"
                                   Maximum="7680"
                                   Increment="1"
                                   FormatString="0"
                                   Width="160" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="1080p" Click="OnPreset1920Click" />
                        <Button Content="1440p" Click="OnPreset2560Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- 16:9 export -->
            <StackPanel Spacing="4">
                <CheckBox IsChecked="{Binding SixteenNineExport}"
                          Content="Export as 16:9 (grid at top, black padding below)" />
                <TextBlock Text="{Binding ExportSizeLabel}"
                           FontSize="11"
                           Margin="24,0,0,0"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
            <CheckBox IsChecked="{Binding InvertMask}"
                      Content="Invert mask (black = active, white = masked)" />
            <CheckBox IsChecked="{Binding ExportBlackAsTransparent}"
                      Content="Export black as transparent" />
        </StackPanel>
    </DockPanel>
</Window>
